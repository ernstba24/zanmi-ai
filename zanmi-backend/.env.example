# Copy this file to .env and replace the placeholder. Never commit .env.
OPENAI_API_KEY=replace-with-your-api-key

# Optional: override the default model (see application.yml).
# OPENAI_MODEL=gpt-4o-mini

# Optional: set a sampling temperature (unset by default, so the OpenAI default applies).
# SPRING_AI_OPENAI_CHAT_OPTIONS_TEMPERATURE=0.7
